DATABASE_URL=postgres://user:pass@localhost:5432/soroverify
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
VERIFIER_API_URL=https://api.soroverify.com

# Optional. Ed25519 private key in base64 PKCS8 DER format.
# If unset, the service generates an ephemeral identity per boot and logs a warning.
# The watcher id will change across restarts, which means drift records from different restarts will have different watcher ids.
WATCHER_PRIVATE_KEY=

# Number of RPC calls allowed per tick. Default is 10.
RPC_CALLS_PER_TICK=10

# How often the scheduler loop runs, in seconds. Default is 60.
TICK_INTERVAL_SECONDS=60

# Default interval for checking active contracts, in seconds. e.g. 3600 (1 hour).
DEFAULT_CHECK_INTERVAL_SECONDS=3600

# Maximum interval for checking active contracts, in seconds. The interval scales up if no drift is found. e.g. 86400 (1 day).
MAX_CHECK_INTERVAL_SECONDS=86400

# Host to bind the API server. Default is 127.0.0.1.
HOST=127.0.0.1

# Port to bind the API server. Default is 8090, deliberately not 8080 so it can run alongside the verifier locally.
PORT=8090
