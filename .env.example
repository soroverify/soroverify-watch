# PostgreSQL connection string
# Required. Example: postgres://user:pass@localhost:5432/soroverify_watch
DATABASE_URL=

# URL for the Stellar RPC endpoint
# Required. Example: https://soroban-testnet.stellar.org
STELLAR_RPC_URL=

# URL for the public API of the soroverify-verifier to query verifications
# Required. Example: https://api.soroverify.com
VERIFIER_API_URL=

# Ed25519 private key in base64 PKCS8 DER format used to sign drift records
# Optional. If unset, an ephemeral identity is generated on boot and the watcher id changes across restarts.
WATCHER_PRIVATE_KEY=

# Number of RPC calls allowed per polling tick
# Optional. Default: 10
RPC_CALLS_PER_TICK=10

# Seconds between each polling scheduler tick
# Optional. Default: 60
TICK_INTERVAL_SECONDS=60

# Default number of seconds between checking a watched contract
# Required. Example: 3600 (1 hour)
DEFAULT_CHECK_INTERVAL_SECONDS=3600

# Maximum number of seconds between checking a watched contract
# Required. Example: 86400 (24 hours)
MAX_CHECK_INTERVAL_SECONDS=86400

# Host to bind the HTTP server to
# Optional. Default: 127.0.0.1
HOST=127.0.0.1

# Port to bind the HTTP server to
# Optional. Default: 8090
PORT=8090
